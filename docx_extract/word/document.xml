<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:mo="http://schemas.microsoft.com/office/mac/office/2008/main" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mv="urn:schemas-microsoft-com:mac:vml" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 wp14"><w:body><w:p><w:pPr><w:spacing w:before="1600"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="60"/></w:rPr><w:t>PROMPTWARS</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="44"/></w:rPr><w:t>BUSINESS RESCUE CHALLENGE</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/></w:rPr><w:t>Participant Challenge Brief</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="360"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="26"/></w:rPr><w:t>PROMPT. DISCOVER. BUILD. PROVE.</w:t></w:r></w:p><w:p><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>1. The Scenario</w:t></w:r></w:p><w:p><w:r><w:t>NOVA CART is a fictional quick-commerce and local shopping platform connecting customers with 620 local grocery stores, pharmacies, bakeries, stationery stores and other retailers across three Indian cities.</w:t></w:r></w:p><w:p><w:r><w:t>The company appears to be growing. It currently has 1,20,000 registered users, 46,000 monthly active users, 38,500 monthly orders, an average order value of ₹486 and monthly revenue of ₹26.1 lakh.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>2. Six-Month Performance</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:type="auto" w:w="0"/><w:jc w:val="center"/><w:tblLook w:firstColumn="1" w:firstRow="1" w:lastColumn="0" w:lastRow="0" w:noHBand="0" w:noVBand="1" w:val="04A0"/></w:tblPr><w:tblGrid><w:gridCol w:w="3360"/><w:gridCol w:w="3360"/><w:gridCol w:w="3360"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:shd w:fill="D9EAF7"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Metric</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:shd w:fill="D9EAF7"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>6 Months Ago</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:shd w:fill="D9EAF7"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Current</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Registered Users</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>82,000</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>1,20,000</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Monthly Active Users</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>39,000</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>46,000</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Monthly Orders</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>31,200</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>38,500</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Average Order Value</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>₹452</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>₹486</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Repeat Purchase Rate</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>41%</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>27%</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Average Delivery Time</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>29 min</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>37 min</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Order Cancellation Rate</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>6%</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>11%</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Customer Support Tickets / Month</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>3,100</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>5,900</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Promotional Spend / Month</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>₹9.5L</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>₹17L</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>Revenue / Month</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>₹21.8L</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="3360"/><w:vAlign w:val="center"/></w:tcPr><w:p><w:r><w:t>₹26.1L</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>NOVA CART is getting bigger. The question is: Is it actually getting better?</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>3. Customer Signals</w:t></w:r></w:p><w:p><w:r><w:t>A survey of 2,000 active and recently inactive customers found:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>38% — Prices/fees feel higher than expected</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>34% — Delivery takes too long</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>29% — Products shown as available sometimes become unavailable after ordering</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>24% — Discounts are confusing</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>21% — Prefer purchasing directly from nearby stores</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>18% — Difficult to discover relevant local products</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>16% — Experienced refund problems</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>14% — App experience feels cluttered</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>11% — Delivery tracking is inaccurate</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Important signal: </w:t></w:r><w:r><w:t>61% of customers who stopped ordering had previously rated NOVA CART 4★ or higher.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>4. Customer Behaviour</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>54% of new users complete their first order.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Only 31% place a second order within 30 days.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Customers completing 3 orders have a 72% probability of ordering again the following month.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Customers acquired through large first-order discounts show lower long-term retention than organically acquired users.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>44% of promotional coupons are never redeemed.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>19% of customers repeatedly search for products unavailable from nearby stores.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Customers purchasing across multiple store categories show higher repeat usage.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>5. Operations</w:t></w:r></w:p><w:p><w:r><w:t>Recent order data shows:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>11% — Cancelled</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>13% — Delivered more than 15 minutes after the estimated time</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>8% — Contained at least one substituted item</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>6% — Required a refund/support interaction</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Cancellation Reasons</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>35% — Product unavailable</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>27% — Customer cancelled because of delay</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>18% — Store rejected the order</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>12% — Delivery partner unavailable</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>8% — Other reasons</w:t></w:r></w:p><w:p><w:r><w:t>Many partner stores manually maintain inventory. Some update stock multiple times per day, while others update it only once every 1–3 days.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>6. Partner Store Signals</w:t></w:r></w:p><w:p><w:r><w:t>NOVA CART interviewed 100 partner stores:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>46% believe NOVA CART brings valuable additional customers.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>39% say maintaining online inventory requires too much effort.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>31% believe promotions reduce their margins.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>28% struggle to predict which products will sell online.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>23% occasionally reject orders during busy periods.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>18% are considering leaving the platform within the next year.</w:t></w:r></w:p><w:p><w:pPr><w:ind w:left="504"/></w:pPr><w:r><w:rPr><w:i/></w:rPr><w:t>“NOVA CART gives us orders, but sometimes maintaining the online catalogue takes more effort than the additional business is worth.”</w:t></w:r></w:p><w:p><w:pPr><w:ind w:left="504"/></w:pPr><w:r><w:rPr><w:i/></w:rPr><w:t>“Customers blame us when the app says something is available but we don't actually have it.”</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>7. Marketing</w:t></w:r></w:p><w:p><w:r><w:t>NOVA CART currently spends approximately ₹17 lakh per month on promotions and customer acquisition. Around 58% of the marketing budget focuses on acquiring new customers, and management is considering increasing total marketing spending by another 30%.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>First-order discounts</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Referral rewards</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Social media advertising</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Influencer promotions</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Festival coupons</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Free-delivery campaigns</w:t></w:r></w:p><w:p><w:r><w:t>The marketing team believes more users will eventually create more repeat customers. The finance team disagrees.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>8. Customer Support</w:t></w:r></w:p><w:p><w:r><w:t>Support tickets increased from 3,100 to 5,900 per month.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>29% — Refund status</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>24% — Delayed delivery</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>19% — Missing/unavailable products</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>13% — Coupon problems</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>9% — Incorrect orders</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>6% — Other</w:t></w:r></w:p><w:p><w:r><w:t>Average resolution time is 9.2 hours. Customer support currently relies on separate systems for orders, refunds and store communication.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>9. Competitive Environment</w:t></w:r></w:p><w:p><w:r><w:t>NOVA CART competes with large quick-commerce platforms, food-delivery applications expanding into groceries, supermarket delivery services and local stores accepting direct digital orders.</w:t></w:r></w:p><w:p><w:r><w:t>Larger competitors can often provide faster delivery and larger discounts. However, NOVA CART has a potential advantage: hundreds of independent local stores carrying products that may not be available through larger platforms. The company has not yet developed a clear strategy around this advantage.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>10. Financial &amp; Business Constraints</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Maximum additional implementation budget for the next six months: ₹25 LAKH</w:t></w:r></w:p><w:p><w:r><w:t>Management does not want solutions requiring:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Massive physical infrastructure expansion</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Hundreds of new employees</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Opening warehouses across the cities</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Unsustainable customer discounts</w:t></w:r></w:p><w:p><w:r><w:t>The company is willing to change its application, internal workflows, store-facing systems, customer experience, pricing mechanisms, marketing strategy, data usage, delivery processes and partner-store experience.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>11. Existing Technology</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Customer mobile application</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Basic website</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Partner-store dashboard</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Order database</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Customer database</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Delivery tracking</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Payment gateway</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Coupon system</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Basic analytics dashboard</w:t></w:r></w:p><w:p><w:r><w:t>These systems were developed separately as the company grew, and information does not always move efficiently between them.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>12. Management Disagreement</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">CEO: </w:t></w:r><w:r><w:t>“We need to improve customer retention.”</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Marketing Head: </w:t></w:r><w:r><w:t>“We need stronger acquisition and better promotions.”</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Operations Head: </w:t></w:r><w:r><w:t>“Delivery reliability is damaging the experience.”</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Partner Manager: </w:t></w:r><w:r><w:t>“Inventory accuracy and store experience are the real bottlenecks.”</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Product Head: </w:t></w:r><w:r><w:t>“We're treating ourselves like another delivery app instead of giving customers a reason to choose local commerce.”</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Finance Head: </w:t></w:r><w:r><w:t>“Our problem isn't growth. It's the quality and cost of that growth.”</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Each position has supporting evidence. You decide what deserves priority.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>13. Your Challenge</w:t></w:r></w:p><w:p><w:r><w:t>Act as NOVA CART's AI-powered Business Innovation Team. Use AI, Prompt Engineering, Business Reasoning, Research, Data and Creativity to investigate the business, identify a high-impact underlying problem or opportunity, and validate why it deserves attention.</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="28"/></w:rPr><w:t>DESIGN AND DEVELOP A FUNCTIONAL WEB OR MOBILE APPLICATION THAT ADDRESSES IT.</w:t></w:r></w:p><w:p><w:r><w:t>There is no predefined application to build and no single expected solution. Your investigation determines your product.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>14. How to Approach the Challenge</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">DISCOVER — </w:t></w:r><w:r><w:t>Analyse the business information. Look beyond surface-level symptoms and identify patterns, relationships, contradictions and opportunities.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">PROMPT — </w:t></w:r><w:r><w:t>Use AI as a reasoning partner to investigate assumptions, generate hypotheses, compare possibilities, challenge conclusions and improve product decisions.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">VALIDATE — </w:t></w:r><w:r><w:t>Support your chosen problem using the case evidence and, where useful, external research and data.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">DESIGN — </w:t></w:r><w:r><w:t>Determine your target user, the problem being solved, why it matters, the required product flow and the features that create meaningful value.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">BUILD — </w:t></w:r><w:r><w:t>Develop a functional Web Application or Mobile Application demonstrating the core solution.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">PROVE — </w:t></w:r><w:r><w:t>Demonstrate how the solution can create measurable business value.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>15. Research &amp; Data Freedom</w:t></w:r></w:p><w:p><w:r><w:t>Participants may strengthen their analysis and solution using:</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Web research</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Publicly accessible web scraping</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>External/public datasets</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Kaggle and other open datasets</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Government/open-data sources</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Public/free APIs</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Research reports and other legitimate sources</w:t></w:r></w:p><w:p><w:r><w:t>External information should have a clear purpose: validate an assumption, discover an opportunity, improve the product or support a decision.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>16. Functional Prototype Requirement</w:t></w:r></w:p><w:p><w:r><w:t>The application must demonstrate meaningful core functionality. Static UI screens alone are not considered a complete functional prototype.</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>INPUT → PROCESSING / LOGIC → ACTION / RECOMMENDATION / OUTPUT</w:t></w:r></w:p><w:p><w:r><w:t>Your demo should make it clear who uses the product, what they do, what the system does, and what business value is created.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>17. Technology Freedom</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>AI tools and AI-assisted coding</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>No-code / low-code platforms</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Frontend and backend frameworks</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Databases</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Cloud and deployment platforms</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Public/free APIs</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Web scraping</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>External datasets</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Open-source libraries</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>AI-generated code</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="40"/></w:pPr><w:r><w:t>Traditional programming</w:t></w:r></w:p><w:p><w:r><w:t>Paid API keys, LLM integration, custom AI/ML model training and custom AI infrastructure are not mandatory. Using more technology does not automatically make a solution stronger. Technology should serve the problem.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>18. What You Must Submit</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">1. Problem Diagnosis — </w:t></w:r><w:r><w:t>Clearly explain the underlying problem or opportunity identified and the evidence supporting it.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">2. Prompt Journey — </w:t></w:r><w:r><w:t>Show the key prompts that influenced your analysis, reasoning and product decisions. Do not submit every AI conversation.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">3. Solution Explanation — </w:t></w:r><w:r><w:t>Explain what you built, who it is for and why this solution addresses the diagnosed problem.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">4. Functional Prototype — </w:t></w:r><w:r><w:t>Submit a working Web or Mobile Application demonstrating the core functionality.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">5. Source Code — </w:t></w:r><w:r><w:t>Provide the project repository containing your implementation.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">6. Demo — </w:t></w:r><w:r><w:t>Demonstrate the application's primary user journey and functionality.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">7. Business Impact — </w:t></w:r><w:r><w:t>Explain the measurable value your solution could create, such as revenue, retention, conversion, cost, time, customer satisfaction, productivity, accuracy or operational efficiency.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>19. Important</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>A beautiful application solving the wrong problem is not enough.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>A complex application without clear business value is not enough.</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>A generic AI-generated idea converted into a website is not enough.</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t>EVIDENCE → PROMPTING → INSIGHT → PROBLEM → PRODUCT → FUNCTIONAL BUILD → BUSINESS IMPACT</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>20. Final Question</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="26"/></w:rPr><w:t>If NOVA CART could build one digital product or major digital intervention right now, what should it build — and can you prove why?</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="360"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:b/><w:sz w:val="32"/></w:rPr><w:t>PROMPT. DISCOVER. BUILD. PROVE.</w:t></w:r></w:p><w:sectPr w:rsidR="00FC693F" w:rsidRPr="0006063C" w:rsidSect="00034616"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="936" w:right="1080" w:bottom="936" w:left="1080" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>